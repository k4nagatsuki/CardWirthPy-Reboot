+def confirm(message):
+    "ask a yes/no question, return result"
+    if not sys.stdout.isatty():
+        return False
+    reply = raw_input('\n' + message + ' [Y/n]:')
+    if reply and (reply[0].lower()) == 'n':
+        return False
+    return True
